@model Planora.Services.DTOs.ScheduleGenerationResultDto

@{
    ViewData["Title"] = Model.Success ? "Generation Successful" : "Generation Encountered Issues";
    ViewData["Breadcrumb"] = "Admin / Schedule / Result";
}

<div class="glass-card" style="max-width: 900px; margin: 0 auto; padding: 3rem;">
    
    @if (Model.Success)
    {
        <div style="text-align: center; margin-bottom: 2rem;">
            <div style="background: rgba(16, 185, 129, 0.1); width: 80px; height: 80px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 2rem;">
                <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
            </div>
            <h2 style="font-size: 2.2rem; color: #fff; margin-bottom: 0.5rem; font-weight: 800;">Schedule Created!</h2>
            <p style="color: #10b981; font-weight: 600; font-size: 1.1rem;">Success: @Model.TotalEntriesCreated lessons successfully scheduled.</p>
        </div>
    }
    else
    {
        <div style="text-align: center; margin-bottom: 2rem;">
            <div style="background: rgba(239, 68, 68, 0.1); width: 80px; height: 80px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 2rem;">
                <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="8" x2="12" y2="12"></line>
                    <line x1="12" y1="16" x2="12.01" y2="16"></line>
                </svg>
            </div>
            <h2 style="font-size: 2.2rem; color: #fff; margin-bottom: 0.5rem; font-weight: 800;">Generation Failed</h2>
            <p style="color: #ef4444; font-weight: 600; font-size: 1.1rem;">Engine stopped due to critical errors.</p>
        </div>
    }

    @if (Model.Errors != null && Model.Errors.Any())
    {
        <div style="background: rgba(239, 68, 68, 0.05); border: 1px solid rgba(239, 68, 68, 0.2); border-radius: 12px; padding: 1.5rem; margin-bottom: 2rem;">
            <h4 style="color: #ef4444; margin: 0 0 1rem 0; font-weight: 600;">Critical Errors:</h4>
            <ul style="color: var(--text-secondary); margin: 0; padding-left: 1.5rem;">
                @foreach (var error in Model.Errors)
                {
                    <li style="margin-bottom: 0.5rem;">@error</li>
                }
            </ul>
        </div>
    }

    @if (Model.Warnings != null && Model.Warnings.Any())
    {
        <div style="background: rgba(245, 158, 11, 0.05); border: 1px solid rgba(245, 158, 11, 0.2); border-radius: 12px; padding: 1.5rem; margin-bottom: 2rem;">
            <h4 style="color: #fbbf24; margin: 0 0 1rem 0; font-weight: 600;">Warnings (Items requiring manual assignment):</h4>
            <ul style="color: var(--text-secondary); margin: 0; padding-left: 1.5rem;">
                @foreach (var warning in Model.Warnings)
                {
                    <li style="margin-bottom: 0.5rem;">@warning</li>
                }
            </ul>
        </div>
    }

    <div style="display: flex; gap: 1rem; justify-content: center; margin-top: 3rem;">
        <a asp-controller="Schedule" asp-action="Index" class="btn-modern" style="margin: 0; min-width: 200px; text-align: center; background: linear-gradient(135deg, #10b981, #059669); font-weight: 700;">View Timetable</a>
        <a asp-controller="Admin" asp-action="Index" class="btn-modern" style="margin: 0; min-width: 200px; text-align: center; background: rgba(255,255,255,0.05);">Back to Dashboard</a>
    </div>

</div>
