<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Planora - Розумний розклад</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Planora.Web.styles.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            margin: 0;
            padding: 0;
            background: #0f172a;
            color: #f8fafc;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            position: relative;
            overflow-x: hidden;
        }

        /* Ambient glowing background */
        .ambient-bg {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            z-index: -1;
            overflow: hidden;
            background: #0f172a;
        }
        
        .ambient-glow {
            position: absolute;
            border-radius: 50%;
            filter: blur(100px);
            opacity: 0.5;
            animation: float 20s infinite ease-in-out alternate;
        }

        .glow-1 {
            background: rgba(168, 85, 247, 0.2);
            width: 600px;
            height: 600px;
            top: -10%;
            left: -10%;
        }

        .glow-2 {
            background: rgba(56, 189, 248, 0.2);
            width: 500px;
            height: 500px;
            bottom: -10%;
            right: -10%;
            animation-delay: -5s;
        }

        @@keyframes float {
            0% { transform: translate(0, 0) scale(1); }
            50% { transform: translate(50px, 50px) scale(1.05); }
            100% { transform: translate(-20px, 20px) scale(0.95); }
        }

        /* Landing Header */
        .landing-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1.5rem 5%;
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            background: rgba(15, 23, 42, 0.7);
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .logo-brand {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            font-size: 1.5rem;
            font-weight: 800;
            color: #f8fafc;
            text-decoration: none;
            letter-spacing: -0.5px;
        }

        .logo-dot {
            width: 12px;
            height: 12px;
            background: linear-gradient(135deg, #38bdf8, #818cf8);
            border-radius: 50%;
            box-shadow: 0 0 15px rgba(56, 189, 248, 0.6);
        }

        .auth-buttons {
            display: flex;
            gap: 1rem;
            align-items: center;
        }

        .btn-login {
            color: #cbd5e1;
            text-decoration: none;
            font-weight: 500;
            transition: color 0.2s;
            padding: 0.5rem 1rem;
            border-radius: 8px;
        }

        .btn-login:hover {
            color: #f8fafc;
            background: rgba(255,255,255,0.05);
        }

        .btn-register {
            background: linear-gradient(135deg, #38bdf8, #818cf8);
            color: white;
            padding: 0.6rem 1.5rem;
            border-radius: 12px;
            text-decoration: none;
            font-weight: 600;
            box-shadow: 0 4px 15px rgba(56, 189, 248, 0.3);
            transition: all 0.3s ease;
        }

        .btn-register:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(56, 189, 248, 0.4);
        }

        /* Landing Footer */
        .landing-footer {
            margin-top: auto;
            text-align: center;
            padding: 2rem 5%;
            color: #64748b;
            font-size: 0.9rem;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
            background: rgba(15, 23, 42, 0.4);
            backdrop-filter: blur(5px);
        }
        
        .landing-footer a {
            color: #94a3b8;
            text-decoration: none;
            transition: color 0.2s;
            margin: 0 0.5rem;
        }

        .landing-footer a:hover {
            color: #f8fafc;
        }
    </style>
</head>
<body>
    <div class="ambient-bg">
        <div class="ambient-glow glow-1"></div>
        <div class="ambient-glow glow-2"></div>
    </div>

    <header class="landing-header">
        <a asp-controller="Home" asp-action="Index" class="logo-brand">
            <div class="logo-dot"></div>
            Planora
        </a>
        <div class="auth-buttons">
            <a asp-controller="Account" asp-action="Login" class="btn-login">Увійти</a>
            <a asp-controller="Account" asp-action="Register" class="btn-register">Зареєструватись</a>
        </div>
    </header>

    @RenderBody()

    <footer class="landing-footer">
        <div>&copy; @DateTime.Now.Year Planora. Навчаємось разом!</div>
    </footer>
</body>
</html>
