@model IEnumerable<Planora.Services.DTOs.SubjectDto>

@{
    ViewData["Title"] = "Керування предметами";
    ViewData["Breadcrumb"] = "Адмін / Предмети";
}

<div class="glass-card" style="max-width: 1000px; margin: 0 auto;">
    <div class="glass-card-header" style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid rgba(255, 255, 255, 0.1); padding-bottom: 1rem; margin-bottom: 2rem;">
        <h2 style="font-size: 2rem; color: #fff; margin: 0; font-weight: 700;">Предмети</h2>
        <a asp-action="Create" class="btn-modern" style="margin: 0; padding: 0.8rem 2rem; width: auto;">+ Новий предмет</a>
    </div>

    @if (!Model.Any())
    {
        <div style="text-align: center; padding: 4rem; color: var(--text-secondary); background: rgba(15, 23, 42, 0.4); border-radius: 16px;">
            <p style="font-size: 1.1rem; margin-bottom: 0;">Предметів поки не знайдено.</p>
        </div>
    }
    else
    {
        <div style="background: rgba(15, 23, 42, 0.4); border-radius: 16px; border: 1px solid rgba(255,255,255,0.05); overflow: hidden;">
            <table style="width: 100%; border-collapse: collapse;">
                <thead>
                    <tr style="background: rgba(255,255,255,0.03); text-align: left; border-bottom: 1px solid rgba(255,255,255,0.05);">
                        <th style="padding: 1rem; color: #fff; font-weight: 600;">Назва предмета</th>
                        <th style="padding: 1rem; color: #fff; font-weight: 600;">Тип</th>
                        <th style="padding: 1rem; color: #fff; font-weight: 600;">Особливі вимоги</th>
                        <th style="padding: 1rem; color: #fff; font-weight: 600; text-align: right;">Дії</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach(var item in Model)
                    {
                        <tr style="border-bottom: 1px solid rgba(255,255,255,0.03);">
                            <td style="padding: 1rem; color: #fff; font-weight: 600;">@item.Name</td>
                            <td style="padding: 1rem;">
                                @if(item.Type == Planora.Domain.Enums.LessonType.Lecture)
                                {
                                    <span style="color: #60a5fa; background: rgba(59, 130, 246, 0.1); padding: 0.2rem 0.6rem; border-radius: 6px; font-size: 0.8rem; border: 1px solid rgba(59, 130, 246, 0.2);">Лекція</span>
                                }
                                else
                                {
                                    <span style="color: #34d399; background: rgba(52, 211, 153, 0.1); padding: 0.2rem 0.6rem; border-radius: 6px; font-size: 0.8rem; border: 1px solid rgba(52, 211, 153, 0.2);">Практика</span>
                                }
                            </td>
                            <td style="padding: 1rem; color: var(--text-secondary); font-size: 0.9rem;">
                                @(string.IsNullOrEmpty(item.Requirements) ? "Немає" : item.Requirements)
                            </td>
                            <td style="padding: 1rem; text-align: right;">
                                <div style="display: flex; gap: 0.5rem; justify-content: flex-end;">
                                    <a asp-action="Edit" asp-route-id="@item.Id" style="padding: 0.4rem 0.8rem; border-radius: 8px; background: rgba(59, 130, 246, 0.1); color: #60a5fa; text-decoration: none; font-size: 0.9rem;">Редагувати</a>
                                    
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display: inline;" onsubmit="return confirm('Видалити предмет @item.Name?');">
                                        <button type="submit" style="padding: 0.4rem 0.8rem; border-radius: 8px; background: rgba(248, 113, 113, 0.1); color: #f87171; border: none; cursor: pointer; font-size: 0.9rem;">Видалити</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
