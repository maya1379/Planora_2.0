@model IEnumerable<Planora.Services.DTOs.ScheduleEntryDto>
@using Planora.Domain.Enums

@{
    ViewData["Title"] = "Розклад";
    ViewData["Breadcrumb"] = "Розклад";
    
    var days = new[] { 
        DayOfWeekEnum.Monday, 
        DayOfWeekEnum.Tuesday, 
        DayOfWeekEnum.Wednesday, 
        DayOfWeekEnum.Thursday, 
        DayOfWeekEnum.Friday 
    };

    string GetDayName(DayOfWeekEnum day) => day switch {
        DayOfWeekEnum.Monday => "Понеділок",
        DayOfWeekEnum.Tuesday => "Вівторок",
        DayOfWeekEnum.Wednesday => "Середа",
        DayOfWeekEnum.Thursday => "Четвер",
        DayOfWeekEnum.Friday => "П'ятниця",
        DayOfWeekEnum.Saturday => "Субота",
        _ => "Неділя"
    };
}

<div class="glass-card">
    <div style="text-align: center; margin-bottom: 2rem;">
        <h2 style="font-size: 2.2rem; background: var(--accent-gradient); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; font-weight: 800; margin: 0;">Сьогодні (@GetDayName((DayOfWeekEnum)(int)DateTime.Now.DayOfWeek))</h2>
    </div>

    <div class="controls-bar" style="justify-content: space-between;">
        <div style="display: flex; gap: 1rem; align-items: center;">
            <select id="viewModeSelect" class="modern-select" onchange="toggleViewMode()">
                <option value="day">За днем</option>
                <option value="week" selected>За тижнем</option>
                <option value="month">За місяцем</option>
            </select>
            
            <div class="search-wrapper">
                <input type="text" id="scheduleSearch" class="modern-input" placeholder="Пошук..." onkeyup="filterSchedule()" />
            </div>
        </div>

        <div style="display: flex; gap: 0.5rem; background: rgba(255,255,255,0.02); padding: 0.35rem; border-radius: 12px; border: 1px solid rgba(255,255,255,0.05);">
            <a asp-controller="Schedule" asp-action="ExportExcel" asp-route-groupId="@ViewBag.GroupId" asp-route-teacherId="@ViewBag.TeacherId" class="schedule-toolbar-btn schedule-toolbar-btn--export-excel">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 6px;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="8" y1="13" x2="16" y2="13"></line><line x1="8" y1="17" x2="16" y2="17"></line></svg>
                Excel
            </a>
            <a asp-controller="Schedule" asp-action="ExportPdf" asp-route-groupId="@ViewBag.GroupId" asp-route-teacherId="@ViewBag.TeacherId" class="schedule-toolbar-btn schedule-toolbar-btn--export-pdf">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 6px;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><path d="M9 15v-6h3.5a2 2 0 1 1 0 4h-3.5"></path></svg>
                PDF
            </a>
        </div>
    </div>

    @if (User.Identity == null || !User.Identity.IsAuthenticated)
    {
        <div style="text-align: center; padding: 4rem; margin-top: 1rem; color: var(--text-secondary); background: rgba(15, 23, 42, 0.4); border-radius: 16px;">
            <p style="font-size: 1.1rem; margin-bottom: 2rem;">Будь ласка, увійдіть, щоб побачити свій персональний розклад на сьогодні.</p>
            <a asp-controller="Account" asp-action="Login" class="btn-modern" style="display: inline-block; width: auto; min-width: 280px; padding: 1rem 3rem; margin-bottom: 0;">Увійти</a>
        </div>
    }
    else if (Model == null || !Model.Any())
    {
        <div style="text-align: center; padding: 4rem; margin-top: 1rem; color: var(--text-secondary); background: rgba(16, 185, 129, 0.05); border: 1px dashed rgba(16, 185, 129, 0.3); border-radius: 16px;">
            <p style="font-size: 1.2rem; margin: 0; color: #10b981;">На цей тиждень занять не заплановано. 🎉</p>
        </div>
    }
    else
    {
        <div class="schedule-board" id="scheduleBoard" style="margin-top: 1rem; transition: all 0.3s ease;">
            @foreach (var day in days)
            {
                var dayClasses = Model.Where(c => c.DayOfWeek == day).OrderBy(c => c.StartTime).ToList();
                var currentRealDay = (int)DateTime.Now.DayOfWeek;
                if (currentRealDay == 0 || currentRealDay == 6) currentRealDay = 1;

                var isToday = (int)day == currentRealDay;
                var todayStyle = isToday ? "border-top: 2px solid #5A6BEE;" : "";
                
                <div class="schedule-day-column" data-day="@((int)day)" style="@todayStyle">
                    <div class="schedule-day-header" style="@(isToday ? "color: #fff; font-weight: 700;" : "")">@GetDayName(day)</div>
                    
                    @if (!dayClasses.Any())
                    {
                        <div class="schedule-empty-slot">Немає занять</div>
                    }
                    else
                    {
                        @foreach (var item in dayClasses)
                        {
                            var isPractice = item.LessonType.ToString().Contains("Practice") || item.LessonType.ToString().Contains("Lab") || item.LessonType.ToString() == "1";
                            var badgeStyle = isPractice ? "background: rgba(16, 185, 129, 0.15); color: #34d399;" : "background: rgba(59, 130, 246, 0.15); color: #60a5fa;";
                            var badgeText = isPractice ? "ПРАКТИКА" : "ЛЕКЦІЯ";

                            <div class="schedule-class-card" 
                                 data-schedule-id="@item.Id"
                                 onclick="openNotesModal(@item.Id, '@Html.Raw(item.SubjectName.Replace("'", "\\'"))')"
                                 data-search="@item.SubjectName @item.TeacherName @item.GroupName @item.ClassroomNumber"
                                 style="cursor: pointer;">
                                 
                                <div class="schedule-class-badge" style="@badgeStyle">@badgeText</div>
                                <div class="schedule-class-time">@item.StartTime.ToString(@"hh\:mm") - @item.EndTime.ToString(@"hh\:mm")</div>
                                <div class="schedule-class-title">@item.SubjectName</div>
                                
                                <div class="schedule-class-details">
                                    <div class="schedule-class-detail-item">Ауд. @(string.IsNullOrEmpty(item.ClassroomNumber) ? "?" : item.ClassroomNumber)</div>
                                    @if (User.IsInRole("Student"))
                                    {
                                        <div class="schedule-class-detail-item" title="@item.TeacherName">Викл. @item.TeacherName</div>
                                    }
                                    else if (User.IsInRole("Teacher"))
                                    {
                                        <div class="schedule-class-detail-item" title="@item.GroupName">Гр. @item.GroupName</div>
                                    }
                                </div>
                            </div>
                        }
                    }
                </div>
            }
        </div>
    }
</div>

<!-- Notes Modal -->
<div id="notesModal" class="modal-overlay" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 1000; justify-content: center; align-items: center;">
    <div class="modal-content" style="background: #1e293b; padding: 2rem; border-radius: 16px; width: 90%; max-width: 500px; box-shadow: 0 10px 25px rgba(0,0,0,0.8); border: 1px solid rgba(255,255,255,0.1); color: #f8fafc;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
            <h3 id="notesModalTitle" style="margin: 0; font-size: 1.5rem; font-weight: 700;">Нотатки</h3>
            <button onclick="closeNotesModal()" style="background: none; border: none; color: #94a3b8; cursor: pointer; font-size: 1.5rem; transition: color 0.2s;" onmouseover="this.style.color='#f1f5f9'" onmouseout="this.style.color='#94a3b8'">&times;</button>
        </div>
        
        <div id="notesContainer" style="max-height: 300px; overflow-y: auto; margin-bottom: 1.5rem; display: flex; flex-direction: column; gap: 0.8rem; padding-right: 0.5rem;">
            <!-- Notes will be loaded here -->
        </div>

        <div style="display: flex; flex-direction: column; gap: 0.8rem;">
            <input type="hidden" id="currentScheduleId" />
            <textarea id="newNoteContent" class="modern-input" placeholder="Додати нотатку..." style="resize: vertical; min-height: 80px; width: 100%; box-sizing: border-box; background: rgba(0,0,0,0.2); border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; padding: 0.8rem; color: #f8fafc; font-family: inherit; font-size: 0.95rem;"></textarea>
            <button onclick="addNote()" class="btn-modern" style="width: 100%; border-radius: 8px; padding: 0.8rem; font-weight: 600; text-align: center; display: block; margin: 0;">Додати</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function filterSchedule() {
            const query = document.getElementById("scheduleSearch").value.toLowerCase();
            const cards = document.getElementsByClassName("schedule-class-card");

            for (let i = 0; i < cards.length; i++) {
                const card = cards[i];
                const content = card.getAttribute("data-search").toLowerCase();
                
                if (content.includes(query)) {
                    card.style.display = "flex";
                } else {
                    card.style.display = "none";
                }
            }
        }

        function toggleViewMode() {
            const mode = document.getElementById("viewModeSelect").value;
            const columns = document.getElementsByClassName("schedule-day-column");
            const board = document.getElementById("scheduleBoard");

            if (!board) return;

            let today = new Date().getDay(); 
            if (today === 0 || today === 6) today = 1; 

            if (mode === "day") {
                board.style.gridTemplateColumns = "1fr";
                
                for (let i = 0; i < columns.length; i++) {
                    const colDay = parseInt(columns[i].getAttribute("data-day"));
                    if (colDay === today) {
                        columns[i].style.display = "flex";
                        columns[i].style.width = "100%";
                    } else {
                        columns[i].style.display = "none";
                    }
                }
            } 
            else if (mode === "month") {
                alert("Перегляд за місяцем буде доступний незабаром! Повертаємося до тижневого вигляду.");
                document.getElementById("viewModeSelect").value = "week";
                toggleViewMode();
            }
            else { 
                board.style.gridTemplateColumns = "";
                
                for (let i = 0; i < columns.length; i++) {
                    columns[i].style.display = "flex";
                    columns[i].style.width = "";
                }
            }
        }

        document.addEventListener("DOMContentLoaded", function() {
            toggleViewMode();
        });

        function openNotesModal(scheduleId, subjectName) {
            document.getElementById('currentScheduleId').value = scheduleId;
            document.getElementById('notesModalTitle').innerText = subjectName + " - Нотатки";
            document.getElementById('notesModal').style.display = 'flex';
            document.body.style.overflow = 'hidden';
            loadNotes(scheduleId);
        }

        function closeNotesModal() {
            document.getElementById('notesModal').style.display = 'none';
            document.getElementById('newNoteContent').value = '';
            document.body.style.overflow = '';
        }

        window.onclick = function(event) {
            var modal = document.getElementById('notesModal');
            if (event.target == modal) {
                closeNotesModal();
            }
        }

        function loadNotes(scheduleId) {
            const container = document.getElementById('notesContainer');
            container.innerHTML = '<div style="text-align:center; color:var(--text-secondary);">Завантаження...</div>';

            fetch(`/Schedule/GetNotes?scheduleId=${scheduleId}`)
                .then(response => response.json())
                .then(notes => {
                    container.innerHTML = '';
                    if (notes.length === 0) {
                        container.innerHTML = '<div style="text-align:center; color:var(--text-secondary);">Немає нотаток. Будьте першим!</div>';
                        return;
                    }
                    
                    notes.forEach(note => {
                        const date = new Date(note.createdAt).toLocaleString('uk-UA');
                        const noteDiv = document.createElement('div');
                        noteDiv.style.cssText = 'background: rgba(255,255,255,0.05); padding: 1rem; border-radius: 8px; position: relative;';
                        noteDiv.innerHTML = `
                            <div style="margin-bottom: 0.5rem; display: flex; justify-content: space-between; align-items: center; padding-right: 1.5rem;">
                                <span style="font-size: 0.8rem; color: #94a3b8;">${date}</span>
                            </div>
                            <div style="white-space: pre-wrap; font-size: 0.95rem; margin-bottom: 0; overflow-wrap: break-word; word-break: break-word;">${note.content}</div>
                            <button onclick="deleteNote(${note.id})" style="position: absolute; top: 0.5rem; right: 0.5rem; background: none; border: none; color: #ef4444; cursor: pointer; font-size: 1.4rem; line-height: 1; padding: 0.2rem; transition: transform 0.2s, color 0.2s;" onmouseover="this.style.transform='scale(1.2)'; this.style.color='#f87171'" onmouseout="this.style.transform='scale(1)'; this.style.color='#ef4444'" title="Видалити">&times;</button>
                        `;
                        container.appendChild(noteDiv);
                    });
                })
                .catch(err => {
                    container.innerHTML = '<div style="text-align:center; color:#ef4444;">Помилка завантаження нотаток.</div>';
                    console.error('Error loading notes:', err);
                });
        }

        function addNote() {
            const scheduleId = document.getElementById('currentScheduleId').value;
            const content = document.getElementById('newNoteContent').value;

            if (!content.trim()) return;

            fetch('/Schedule/AddNote', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ scheduleId: parseInt(scheduleId), content: content })
            })
            .then(response => {
                if (response.ok) {
                    document.getElementById('newNoteContent').value = '';
                    loadNotes(scheduleId);
                } else if (response.status === 401) {
                    alert('Будь ласка, увійдіть, щоб залишати нотатки.');
                } else {
                    alert('Помилка при додаванні нотатки.');
                }
            })
            .catch(err => console.error('Error adding note:', err));
        }

        function deleteNote(noteId) {
            if (!confirm('Видалити нотатку?')) return;

            fetch(`/Schedule/DeleteNote?noteId=${noteId}`, { method: 'POST' })
            .then(response => {
                if (response.ok) {
                    const scheduleId = document.getElementById('currentScheduleId').value;
                    loadNotes(scheduleId);
                } else {
                    alert('Помилка або недостатньо прав для видалення.');
                }
            })
            .catch(err => console.error('Error deleting note:', err));
        }
    </script>

    <style>
        .schedule-toolbar-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 0.6rem 1.2rem;
            border-radius: 10px;
            font-size: 0.8rem;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.2s ease;
            white-space: nowrap;
            border: 1px solid transparent;
        }
        .schedule-toolbar-btn:hover {
            transform: translateY(-1px);
        }
        .schedule-toolbar-btn--export-excel {
            background: rgba(52, 211, 153, 0.08);
            color: #34d399;
            border-color: rgba(52, 211, 153, 0.2);
        }
        .schedule-toolbar-btn--export-excel:hover { background: rgba(52, 211, 153, 0.15); }

        .schedule-toolbar-btn--export-pdf {
            background: rgba(239, 68, 68, 0.08);
            color: #ef4444;
            border-color: rgba(239, 68, 68, 0.2);
        }
        .schedule-toolbar-btn--export-pdf:hover { background: rgba(239, 68, 68, 0.15); }
    </style>
}
