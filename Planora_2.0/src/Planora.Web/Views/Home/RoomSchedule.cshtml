                </td>
            </tr>
            <tr>
                <td>166</td>
                <td>ПМІ-38</td>
                <td></td>
                <td style="text-align: center;">
                    <input type="checkbox" checked class="modern-checkbox" />
                </td>
            </tr>
            <tr>
                <td>154</td>
                <td>ПМІ-41</td>
                <td>Патата</td>
                <td style="text-align: center;">
