                    <input type="radio" name="working1" checked class="modern-checkbox" style="border-radius: 50%;" />
                </td>
            </tr>
            <tr>
                <td>166</td>
                <td>PMI-38</td>
                <td></td>
                <td style="text-align: center;">
                    <input type="checkbox" checked class="modern-checkbox" />
                </td>
            </tr>
            <tr>
                <td>154</td>
                <td>PMI-41</td>
