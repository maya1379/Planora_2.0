@{
    ViewData["Title"] = "Home";
}

<div class="glass-card" style="max-width: 600px; margin: 0 auto;">
    <div class="glass-card-header">
        <h2>Today</h2>
    </div>

    <div class="schedule-list">
        <div class="schedule-header-day">Monday</div>
        <div class="schedule-item">
            <div class="schedule-time">08:30 - 09:50</div>
            <div class="schedule-subject">Math</div>
            <div class="schedule-room-chip">122</div>
        </div>
        <div class="schedule-item">
            <div class="schedule-time">10:10 - 11:30</div>
            <div class="schedule-subject">Programming</div>
            <div class="schedule-room-chip">166</div>
        </div>
        <div class="schedule-item">
            <div class="schedule-time">11:50 - 13:10</div>
            <div class="schedule-subject">Programming</div>
            <div class="schedule-room-chip">166</div>
        </div>
        <div class="schedule-item">
            <div class="schedule-time">13:30 - 14:50</div>
            <div class="schedule-subject">English</div>
            <div class="schedule-room-chip">87</div>
        </div>
    </div>

    <div class="btn-container" style="margin-top: 2.5rem;">
        <a asp-action="Schedule" class="btn-modern">Schedule</a>
        <a asp-controller="Classrooms" asp-action="Index" class="btn-modern">Find a Room</a>
        <a asp-action="FindPerson" class="btn-modern">Find a Person</a>
    </div>
</div>
