@{
    ViewData["Title"] = "Find a Person";
    ViewData["Breadcrumb"] = "Find a Person";
}

<div class="glass-card" style="max-width: 1000px; margin: 0 auto;">
    <div class="glass-card-header">
        <h2>Find a Person</h2>
    </div>

    <div class="controls-bar" style="justify-content: center; flex-direction: column; gap: 1.5rem; margin-bottom: 2.5rem;">
        <div class="segmented-control">
            <button class="active">All</button>
            <button>Professor</button>
            <button>Student</button>
        </div>
        
        <div class="search-wrapper">
            <input type="text" class="modern-input" placeholder="search" style="width: 350px;" />
        </div>
    </div>

    <div class="profile-desktop-layout">
        <!-- Sidebar -->
        <div class="profile-sidebar">
            <div class="profile-card">
                <div class="profile-avatar" style="margin: 0 auto 1.5rem auto;">
                    👨‍🎓
                </div>
                <div class="profile-info">
                    <h3>Full Name</h3>
                    <p>Age: 20</p>
                    <p>Faculty: PMI</p>
                    <p>Bachelor 1st year</p>
                </div>
            </div>
            
            <div class="info-box" style="margin-bottom: 0; flex-grow: 1;">
                <h4>Info:</h4>
                <ul>
                    <li><span style="color: var(--text-secondary); margin-right: 0.5rem; text-decoration: none;">📞</span> Phone number</li>
                    <li><span style="color: var(--text-secondary); margin-right: 0.5rem;">📸</span> IG</li>
                    <li><span style="color: var(--text-secondary); margin-right: 0.5rem;">✉️</span> qwerty@gmail.com</li>
                </ul>
            </div>
        </div>

        <!-- Main Content -->
        <div class="profile-main-content">
            <div class="info-box" style="margin-bottom: 0;">
                <h4>Working on:</h4>
                <ul>
                    <li>Project 1</li>
                    <li>Project 2</li>
                    <li>Project 3</li>
                </ul>
            </div>

            <div class="info-box" style="margin-bottom: 0;">
                <h4>Studying under:</h4>
                <ul>
                    <li>Professor 1</li>
                    <li>Professor 2</li>
                    <li>Professor 3</li>
                </ul>
            </div>
        </div>
    </div>
</div>
