@{
    ViewData["Title"] = "Пошук людини";
    ViewData["Breadcrumb"] = "Пошук людини";
}

<div class="glass-card" style="max-width: 1000px; margin: 0 auto;">
    <div class="glass-card-header">
        <h2>Пошук людини</h2>
    </div>

    <div class="controls-bar" style="justify-content: center; flex-direction: column; gap: 1.5rem; margin-bottom: 2.5rem;">
        <div class="segmented-control">
            <button class="active">Всі</button>
            <button>Викладач</button>
            <button>Студент</button>
        </div>
        
        <div class="search-wrapper">
            <input type="text" class="modern-input" placeholder="пошук..." style="width: 350px;" />
        </div>
    </div>

    <div class="profile-desktop-layout">
        <div class="profile-sidebar">
            <div class="profile-card">
                <div class="profile-avatar" style="margin: 0 auto 1.5rem auto;">
                    👨‍🎓
                </div>
                <div class="profile-info">
                    <h3>ПІБ</h3>
                    <p>Вік: 20</p>
                    <p>Факультет: ПМІ</p>
                    <p>Бакалаврат 1-й курс</p>
                </div>
            </div>
            
            <div class="info-box" style="margin-bottom: 0; flex-grow: 1;">
                <h4>Інформація:</h4>
                <ul>
                    <li><span style="color: var(--text-secondary); margin-right: 0.5rem; text-decoration: none;">📞</span> Номер телефону</li>
                    <li><span style="color: var(--text-secondary); margin-right: 0.5rem;">📸</span> Instagram</li>
                    <li><span style="color: var(--text-secondary); margin-right: 0.5rem;">✉️</span> qwerty@gmail.com</li>
                </ul>
            </div>
        </div>

        <div class="profile-main-content">
            <div class="info-box" style="margin-bottom: 0;">
                <h4>Працює над:</h4>
                <ul>
                    <li>Проєкт 1</li>
                    <li>Проєкт 2</li>
                    <li>Проєкт 3</li>
                </ul>
            </div>

            <div class="info-box" style="margin-bottom: 0;">
                <h4>Навчається у:</h4>
                <ul>
                    <li>Викладач 1</li>
                    <li>Викладач 2</li>
                    <li>Викладач 3</li>
                </ul>
            </div>
        </div>
    </div>
</div>
