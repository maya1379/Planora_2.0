@{
    Layout = "_LandingLayout";
    ViewData["Title"] = "Розумний розклад для вашого університету";
}

<style>
    .hero-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        flex: 1;
        text-align: center;
        padding: 4rem 2rem;
        position: relative;
        z-index: 1;
    }

    .hero-title {
        font-size: 4.5rem;
        font-weight: 800;
        line-height: 1.1;
        margin-bottom: 1.5rem;
        background: linear-gradient(135deg, #f8fafc 0%, #94a3b8 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        max-width: 900px;
        letter-spacing: -1.5px;
    }

    .hero-title span {
        background: linear-gradient(135deg, #38bdf8, #818cf8);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .hero-subtitle {
        font-size: 1.25rem;
        color: #94a3b8;
        max-width: 600px;
        line-height: 1.6;
        margin-bottom: 3rem;
    }

    .hero-buttons {
        display: flex;
        gap: 1rem;
        align-items: center;
    }

    .btn-primary {
        background: linear-gradient(135deg, #38bdf8, #818cf8);
        color: white;
        padding: 1rem 2rem;
        border-radius: 12px;
        text-decoration: none;
        font-weight: 600;
        font-size: 1.1rem;
        box-shadow: 0 10px 25px rgba(56, 189, 248, 0.4);
        transition: all 0.3s ease;
    }

    .btn-primary:hover {
        transform: translateY(-3px);
        box-shadow: 0 15px 35px rgba(56, 189, 248, 0.5);
    }

    .features-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 2rem;
        max-width: 1200px;
        width: 100%;
        margin: 4rem auto 2rem auto;
        padding: 0 2rem;
    }

    .feature-card {
        background: rgba(30, 41, 59, 0.5);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.05);
        padding: 2rem;
        border-radius: 20px;
        text-align: left;
        transition: transform 0.3s ease, background 0.3s ease;
    }

    .feature-card:hover {
        transform: translateY(-5px);
        background: rgba(30, 41, 59, 0.8);
        border-color: rgba(56, 189, 248, 0.2);
    }

    .feature-icon {
        width: 48px;
        height: 48px;
        background: rgba(56, 189, 248, 0.1);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #38bdf8;
        margin-bottom: 1.5rem;
    }

    .feature-title {
        font-size: 1.25rem;
        font-weight: 700;
        margin-bottom: 0.75rem;
        color: #f8fafc;
    }

    .feature-desc {
        color: #94a3b8;
        line-height: 1.6;
    }

    @@media (max-width: 768px) {
        .hero-title {
            font-size: 2.5rem;
        }
        .hero-subtitle {
            font-size: 1.1rem;
        }
    }
</style>

<div class="hero-container">
    <h1 class="hero-title">Керуйте своїм розкладом <span>легко та сучасно</span></h1>
    <p class="hero-subtitle">
        Planora - це інноваційна платформа для студентів та викладачів, яка допомагає зручно переглядати розклад, залишати особисті нотатки до пар та ефективно керувати своїм часом.
    </p>

    <div class="hero-buttons">
        <a asp-controller="Account" asp-action="Register" class="btn-primary">Гайда реєструватись!</a>
    </div>

    <!-- Features -->
    <div class="features-grid">
        <div class="feature-card">
            <div class="feature-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
            </div>
            <h3 class="feature-title">Зручний розклад</h3>
            <p class="feature-desc">Персоналізований розклад для кожного студента та викладача. Завжди знайте, де і коли у вас наступна пара.</p>
        </div>
        <div class="feature-card">
            <div class="feature-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
            </div>
            <h3 class="feature-title">Приватні нотатки</h3>
            <p class="feature-desc">Залишайте особисті записи та нагадування до кожного заняття. Ніхто крім вас їх не побачить.</p>
        </div>
        <div class="feature-card">
            <div class="feature-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line><path d="M11 14a3 3 0 0 0-6 0"></path><circle cx="8" cy="9" r="2"></circle></svg>
            </div>
            <h3 class="feature-title">Пошук викладача</h3>
            <p class="feature-desc">Вам більше не потрібно шукати розклад викладача на кафедрі. Знаходьте будь-якого викладача у два кліки.</p>
        </div>
    </div>
</div>
