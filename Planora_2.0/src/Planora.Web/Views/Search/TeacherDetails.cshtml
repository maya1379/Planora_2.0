@model Planora.Domain.Entities.User
@{
    ViewData["Title"] = Model.FullName;
    ViewData["Breadcrumb"] = "Профіль викладача";
    
    var currentDay = (int)DateTime.Now.DayOfWeek == 0 ? 7 : (int)DateTime.Now.DayOfWeek;
    var todaysSchedule = Model.Schedules
        .Where(s => (int)s.DayOfWeek == currentDay)
        .OrderBy(s => s.TimeSlot.StartTime)
        .ToList();
    
    var currentClass = todaysSchedule.FirstOrDefault(s => 
        DateTime.Now.TimeOfDay >= s.TimeSlot.StartTime && 
        DateTime.Now.TimeOfDay <= s.TimeSlot.EndTime);

    var teachingSubjects = Model.TeachingAssignments
        .Select(ta => ta.Subjects.Name)
        .Distinct()
        .ToList();

    var nameParts = Model.FullName?.Split(' ', StringSplitOptions.RemoveEmptyEntries) ?? Array.Empty<string>();
    var initials = "";
    if (nameParts.Length >= 1) initials += nameParts[0].Substring(0, 1);
    if (nameParts.Length >= 2) initials += nameParts[1].Substring(0, 1);
    initials = initials.ToUpper();
}

<div class="rooms-app-card" style="max-width: 900px; margin: 3rem auto; padding: 3rem; background: #1e243a; border-radius: 20px; box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);">
    <!-- Profile Header -->
    <div style="display: flex; gap: 2rem; align-items: center; margin-bottom: 3rem; border-bottom: 1px solid rgba(255,255,255,0.05); padding-bottom: 2rem; flex-wrap: wrap;">
        <div class="profile-avatar" style="font-size: 3rem; color: #6d83f2; background: #141a29; width: 110px; height: 110px; display: flex; align-items: center; justify-content: center; border-radius: 50%; border: 4px solid #1e243a; box-shadow: 0 0 0 2px rgba(109, 131, 242, 0.3); font-weight: 700; letter-spacing: 2px;">
            @initials
        </div>
        <div>
            <h1 style="color: #fff; margin: 0 0 0.5rem 0; font-size: 2.2rem; font-weight: 700;">@Model.FullName</h1>
            @if (!string.IsNullOrEmpty(Model.Position))
            {
                <span style="display: inline-block; color: #6d83f2; font-size: 1rem; padding: 0.3rem 0.8rem; background: rgba(109, 131, 242, 0.1); border-radius: 8px; font-weight: 600;">@Model.Position</span>
            }
            else
            {
                <span style="display: inline-block; color: #94a3b8; font-size: 1rem; padding: 0.3rem 0.8rem; background: #141a29; border-radius: 8px; font-weight: 600;">Викладач</span>
            }
        </div>
        
    </div>

    <!-- Contact Info -->
    <div style="margin-bottom: 3rem;">
        <h4 style="color: #64748b; font-size: 0.95rem; margin-bottom: 1.2rem; text-transform: uppercase; letter-spacing: 1px;">Контакти та інформація</h4>
        <div style="background: rgba(0, 0, 0, 0.15); border-radius: 16px; padding: 1.5rem;">
            <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.8rem; font-size: 1.05rem;">
                @if (!string.IsNullOrEmpty(Model.Faculty))
                {
                    <li style="display: flex; align-items: center; justify-content: space-between; gap: 1rem; color: #fff; border-bottom: 1px solid rgba(255,255,255,0.02); padding-bottom: 0.8rem;">
                        <span style="color: #64748b;">Факультет</span>
                        <span style="font-weight: 500;">@Model.Faculty</span>
                    </li>
                }
                @if (!string.IsNullOrEmpty(Model.PhoneNumber))
                {
                    <li style="display: flex; align-items: center; justify-content: space-between; gap: 1rem; color: #fff; border-bottom: 1px solid rgba(255,255,255,0.02); padding-bottom: 0.8rem;">
                        <span style="color: #64748b;">Телефон</span>
                        <a href="tel:@Model.PhoneNumber" style="color: #fff; text-decoration: none; font-weight: 500;">@Model.PhoneNumber</a>
                    </li>
                }
                <li style="display: flex; align-items: center; justify-content: space-between; gap: 1rem; color: #fff;">
                    <span style="color: #64748b;">Пошта</span>
                    <a href="mailto:@Model.Email" style="color: #6d83f2; text-decoration: none; font-weight: 500;">@Model.Email</a>
                </li>
            </ul>
        </div>
    </div>

    <!-- Layout for Schedule and Subjects -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(350px, 1fr)); gap: 2.5rem;">
        <!-- Column 1: Schedule -->
        <div>
            <h4 style="color: #64748b; font-size: 0.95rem; margin-bottom: 1.2rem; text-transform: uppercase; letter-spacing: 1px;">Розклад на сьогодні</h4>
            
            @if (currentClass != null)
            {
                <div style="background: rgba(16, 185, 129, 0.1); border-left: 4px solid #10b981; padding: 1.5rem; border-radius: 12px; margin-bottom: 2rem; box-shadow: 0 10px 20px rgba(0,0,0,0.1);">
                    <h4 style="color: #10b981; margin: 0 0 0.8rem 0; font-size: 1rem; font-weight: 600;">🔥 Зараз проводить пару</h4>
                    <div style="color: #fff; font-weight: 700; font-size: 1.15rem; margin-bottom: 0.5rem;">@currentClass.Subjects.Name</div>
                    <div style="color: #94a3b8; font-size: 0.95rem;">Аудиторія: <strong>@currentClass.Classrooms?.Number</strong> &bull; Група: <strong>@(currentClass.Groups?.Name ?? "-")</strong></div>
                </div>
            }

            @if (todaysSchedule.Any())
            {
                <div style="display: flex; flex-direction: column; gap: 1rem;">
                    @foreach (var s in todaysSchedule)
                    {
                        <div style="display: flex; gap: 1.5rem; background: rgba(0,0,0,0.2); border-radius: 12px; padding: 1.5rem; border: 1px solid rgba(255,255,255,0.03); transition: transform 0.2s ease;">
                            <div style="color: #6d83f2; font-weight: 700; font-size: 1.1rem; white-space: nowrap; text-align: right;">
                                @s.TimeSlot.StartTime.ToString(@"hh\:mm") <br/>
                                <span style="color: #64748b; font-size: 0.85rem; font-weight: 500;">@s.TimeSlot.EndTime.ToString(@"hh\:mm")</span>
                            </div>
                            <div style="display:flex; flex-direction: column; justify-content: center;">
                                <span style="color: #fff; font-weight: 600; font-size: 1.1rem; margin-bottom: 0.4rem;">@s.Subjects.Name</span>
                                <span style="color: #94a3b8; font-size: 0.95rem; margin-bottom: 0.5rem;">
                                    Ауд: <span style="color: #fff;">@s.Classrooms?.Number</span> &bull; 
                                    Група: <span style="color: #fff;">@(s.Groups?.Name ?? "-")</span>
                                </span>
                                <span style="display: inline-block; background: rgba(255,255,255,0.05); color: #94a3b8; padding: 0.3rem 0.8rem; border-radius: 6px; font-size: 0.85rem; width: max-content;">
                                    @(s.WeekType == Planora.Domain.Enums.WeekType.Numerator ? "Тиждень: Чисельник" : s.WeekType == Planora.Domain.Enums.WeekType.Denominator ? "Тиждень: Знаменник" : "Щотижня")
                                </span>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div style="color: #64748b; font-size: 1.05rem; margin-bottom: 2rem; text-align: center; padding: 2.5rem; background: rgba(0,0,0,0.1); border-radius: 16px; border: 1px dashed rgba(255,255,255,0.05);">
                    Сьогодні занять немає. Відпочинок! ☕️
                </div>
            }
        </div>

        <!-- Column 2: Subjects -->
        <div>
            <h4 style="color: #64748b; font-size: 0.95rem; margin-bottom: 1.2rem; text-transform: uppercase; letter-spacing: 1px;">Дисципліни (Викладає)</h4>
            <div style="display: flex; flex-wrap: wrap; gap: 0.8rem; background: rgba(0,0,0,0.15); border-radius: 16px; padding: 1.5rem;">
                @if (teachingSubjects.Any())
                {
                    @foreach (var subj in teachingSubjects)
                    {
                        <span style="background: rgba(109, 131, 242, 0.1); color: #818cf8; padding: 0.6rem 1.2rem; border-radius: 30px; font-size: 0.95rem; border: 1px solid rgba(109, 131, 242, 0.3); font-weight: 500;">@subj</span>
                    }
                }
                else
                {
                    <span style="color: #64748b; font-size: 1rem; width: 100%; text-align: center; padding: 1rem 0;">Предмети ще не призначені.</span>
                }
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .btn-modern:hover {
            background: rgba(255,255,255,0.05) !important;
            border-color: rgba(255,255,255,0.2) !important;
        }
    </style>
}
