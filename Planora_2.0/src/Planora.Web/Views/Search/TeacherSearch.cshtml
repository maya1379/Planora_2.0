@model IEnumerable<Planora.Domain.Entities.User>
@{
    ViewData["Title"] = "Пошук викладача";
    ViewData["Breadcrumb"] = "Пошук викладача";
}

<div class="rooms-app-card" style="max-width: 1000px; margin: 3rem auto; padding: 3rem; background: #1e243a; border-radius: 20px; box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);">
    <h1 class="rooms-title" style="color: #6d83f2; text-align: center; font-size: 2.2rem; font-weight: 700; margin-bottom: 2.5rem;">Знайти викладача</h1>

    <form method="get" asp-controller="Search" asp-action="TeacherSearch" class="search-container" style="justify-content: center; display: flex; margin-bottom: 3rem;">
        <div class="search-input-wrapper" style="position: relative; width: 100%; max-width: 500px; display: flex; gap: 1rem; align-items: stretch;">
            <input type="text" name="teacherName" value="@ViewBag.SearchTerm" class="search-input" placeholder="Введіть ПІБ викладача..." style="flex: 1; min-width: 0; background: #141a29; border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 10px; padding: 1rem 1.5rem; color: #fff; font-family: inherit; font-size: 1rem; outline: none; box-sizing: border-box;" />
            <button type="submit" class="btn-modern" style="margin: 0; width: auto; padding: 1rem 2rem; background: #6d83f2; color: #fff; border: none; border-radius: 10px; font-weight: 600; cursor: pointer; transition: all 0.2s ease; box-sizing: border-box;">Шукати</button>
        </div>
    </form>

    @if (Model != null && Model.Any())
    {
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1.5rem; align-items: stretch;">
            @foreach (var teacher in Model)
            {
                <a asp-controller="Search" asp-action="TeacherDetails" asp-route-id="@teacher.Id" style="text-decoration: none; color: inherit; display: flex; flex-direction: column;">
                    <div class="teacher-card" style="background: #252e42; border-radius: 16px; padding: 1.5rem; transition: transform 0.2s ease, background 0.2s ease; border: 1px solid transparent; cursor: pointer; flex: 1; display: flex; flex-direction: column;">
                        
                        <div style="margin-bottom: 1.2rem;">
                            <h3 style="color: #fff; margin: 0 0 0.5rem 0; font-size: 1.15rem; font-weight: 600;">@teacher.FullName</h3>
                            @if (!string.IsNullOrEmpty(teacher.Position))
                            {
                                <span style="display: inline-block; color: #6d83f2; font-size: 0.8rem; padding: 0.3rem 0.8rem; background: rgba(109, 131, 242, 0.1); border-radius: 6px; font-weight: 500;">@teacher.Position</span>
                            }
                            else
                            {
                                <span style="display: inline-block; color: #94a3b8; font-size: 0.8rem; padding: 0.3rem 0.8rem; background: #141a29; border-radius: 6px; font-weight: 500;">Викладач</span>
                            }
                        </div>
                        
                        @if (!string.IsNullOrEmpty(teacher.Faculty) || !string.IsNullOrEmpty(teacher.PhoneNumber))
                        {
                            <div style="background: rgba(0, 0, 0, 0.15); border-radius: 10px; padding: 1rem; margin-top: auto;">
                                <div style="display: flex; flex-direction: column; gap: 0.6rem; font-size: 0.9rem;">
                                    @if (!string.IsNullOrEmpty(teacher.Faculty))
                                    {
                                        <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid rgba(255,255,255,0.02); padding-bottom: 0.4rem;">
                                            <span style="color: #64748b;">Факультет</span>
                                            <span style="color: #fff; font-weight: 500;">@teacher.Faculty</span>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(teacher.PhoneNumber))
                                    {
                                        <div style="display: flex; justify-content: space-between; align-items: center;">
                                            <span style="color: #64748b;">Телефон</span>
                                            <span style="color: #fff; font-weight: 500;">@teacher.PhoneNumber</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </a>
            }
        </div>
    }
    else if (ViewBag.SearchTerm != null)
    {
        <div style="text-align: center; color: #94a3b8; padding: 3rem; background: #141a29; border-radius: 12px; border: 1px dashed rgba(255,255,255,0.05);">
            <p style="font-size: 1.1rem; margin: 0;">За запитом <strong style="color: #fff;">"@ViewBag.SearchTerm"</strong> нікого не знайдено.</p>
        </div>
    }
    else
    {
        <div style="text-align: center; color: #64748b; padding: 3rem;">
            Введіть ім'я викладача або натисніть "Шукати", щоб побачити увесь список.
        </div>
    }
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/classrooms.css" asp-append-version="true" />
    <style>
        .teacher-card:hover {
            transform: scale(1.02);
            background: #2a354c;
            border-color: rgba(109, 131, 242, 0.4);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
        }
        .search-input:focus {
            border-color: #6d83f2 !important;
            background: #182033 !important;
        }
        .btn-modern:hover {
            background: #5b71db !important;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(109, 131, 242, 0.3);
        }
    </style>
}
