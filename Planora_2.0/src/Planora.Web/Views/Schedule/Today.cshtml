@model IEnumerable<Planora.Services.DTOs.ScheduleEntryDto>

@{
    ViewData["Title"] = "Розклад на сьогодні";
    ViewData["Breadcrumb"] = "Розклад / Сьогодні";
}

<div class="glass-card" style="padding: 2.5rem; margin-bottom: 2rem; border-left: 4px solid #6366f1;">
    <div style="display: flex; justify-content: space-between; align-items: flex-end;">
        <div>
            <h2 style="font-size: 2rem; color: #fff; margin: 0; font-weight: 800;">📅 Актуальний розклад</h2>
            <p style="color: var(--text-secondary); margin: 0.5rem 0 0 0; font-size: 1.1rem;">Переглядайте поточні заняття по всьому кампусу.</p>
        </div>
        <div style="text-align: right;">
            <p style="color: #6366f1; font-weight: 700; margin: 0; font-size: 1.2rem;">@DateTime.Now.ToString("dddd, dd MMMM")</p>
        </div>
    </div>
</div>

<div class="glass-card" style="padding: 1rem; margin-bottom: 2rem;">
    <form method="get" asp-action="Today" style="display: flex; gap: 1rem; flex-wrap: wrap;">
        <select name="groupId" asp-items="ViewBag.Groups" class="modern-select" style="flex: 1; min-width: 200px;" onchange="this.form.submit()">
            <option value="">-- Факультет / Група --</option>
        </select>
        <select name="teacherId" asp-items="ViewBag.Teachers" class="modern-select" style="flex: 1; min-width: 200px;" onchange="this.form.submit()">
            <option value="">-- Пошук викладача --</option>
        </select>
        <a asp-action="Today" class="btn-modern" style="margin: 0; background: rgba(255,255,255,0.05);">Скинути</a>
    </form>
</div>

@if (!Model.Any())
{
    <div style="text-align: center; padding: 6rem; background: rgba(15, 23, 42, 0.4); border-radius: 20px; border: 1px dashed rgba(255,255,255,0.1);">
        <svg xmlns="http://www.w3.org/2000/svg" width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.1)" stroke-width="2" style="margin-bottom: 1.5rem;">
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 16 14"></polyline>
        </svg>
        <h4 style="color: rgba(255,255,255,0.4); font-weight: 600;">На сьогодні занять не заплановано.</h4>
        <p style="color: rgba(255,255,255,0.2); margin-top: 0.5rem;">Гарного відпочинку!</p>
    </div>
}
else
{
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(350px, 1fr)); gap: 2rem;">
        @foreach (var entry in Model.OrderBy(e => e.TimeSlotNumber))
        {
            <div class="today-card" style="position: relative; overflow: hidden;">
                <div style="position: absolute; top: 0; left: 0; width: 4px; height: 100%; background: #6366f1;"></div>
                
                <div style="display: flex; justify-content: space-between; margin-bottom: 1.5rem;">
                    <div>
                        <span style="display: block; font-size: 0.8rem; color: #6366f1; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.2rem;">
                            Пара №@entry.TimeSlotNumber
                            @if (entry.IsOnline)
                            {
                                <span style="font-size: 0.65rem; background: rgba(59, 130, 246, 0.1); color: #60a5fa; padding: 0.15rem 0.6rem; border-radius: 8px; margin-left: 0.5rem; border: 1px solid rgba(59, 130, 246, 0.3);">ONLINE</span>
                            }
                        </span>
                        <span style="font-size: 1.1rem; color: #fff; font-weight: 600;">@entry.StartTime.ToString(@"hh\:mm") - @entry.EndTime.ToString(@"hh\:mm")</span>
                    </div>
                    <div style="text-align: right;">
                        <span style="display: block; font-size: 0.75rem; color: #34d399; font-weight: 700; background: rgba(52, 211, 153, 0.1); padding: 0.3rem 0.8rem; border-radius: 20px;">@(entry.IsOnline ? "Онлайн" : $"Ауд. {entry.ClassroomNumber}")</span>
                        @if (!entry.IsOnline)
                        {
                            <span style="display: block; font-size: 0.8rem; color: var(--text-secondary); margin-top: 0.4rem;">@entry.BuildingName</span>
                        }
                    </div>
                </div>

                @if (entry.IsOnline && !string.IsNullOrEmpty(entry.MeetingLink))
                {
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                        <a href="@entry.MeetingLink" target="_blank" style="color: #60a5fa; font-size: 1.25rem; line-height: 1.4; font-weight: bold; text-decoration: none; display: flex; align-items: center; gap: 0.4rem;">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
                            @entry.SubjectName
                        </a>
                        @if (User.IsInRole("Teacher") && User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value == entry.TeacherId)
                        {
                            <button type="button" class="edit-online-btn" onclick="toggleOnlineStatus(@entry.Id, @(entry.IsOnline.ToString().ToLower()), '@(entry.MeetingLink ?? "")')" title="Змінити онлайн статус">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg>
                            </button>
                        }
                    </div>
                }
                else
                {
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                        <h3 style="color: #fff; font-size: 1.25rem; margin: 0; line-height: 1.4;">@entry.SubjectName</h3>
                        @if (User.IsInRole("Teacher") && User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value == entry.TeacherId)
                        {
                            <button type="button" class="edit-online-btn" onclick="toggleOnlineStatus(@entry.Id, @(entry.IsOnline.ToString().ToLower()), '@(entry.MeetingLink ?? "")')" title="Змінити онлайн статус">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg>
                            </button>
                        }
                    </div>
                }
                
                <div style="border-top: 1px solid rgba(255,255,255,0.05); padding-top: 1.2rem; display: flex; align-items: center; justify-content: space-between;">
                    <div style="display: flex; align-items: center; gap: 0.8rem;">
                        <div style="width: 35px; height: 35px; border-radius: 50%; background: linear-gradient(135deg, #4f46e5, #7c3aed); display: flex; align-items: center; justify-content: center; color: #fff; font-weight: 700; font-size: 0.9rem;">
                            @entry.TeacherName[0]
                        </div>
                        <div>
                            <span style="display: block; font-size: 0.9rem; color: #fff; font-weight: 500;">@entry.TeacherName</span>
                            <span style="display: block; font-size: 0.8rem; color: var(--text-secondary);">Викладач</span>
                        </div>
                    </div>
                    <div style="text-align: right;">
                        <span style="display: block; font-size: 0.9rem; color: #a78bfa; font-weight: 700;">@entry.GroupName</span>
                    </div>
                </div>
            </div>
        }
    </div>
}

<style>
    .today-card {
        background: rgba(30, 41, 59, 0.4);
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 12px;
        padding: 1.5rem;
        transition: transform 0.2s, box-shadow 0.2s;
    }
    .today-card:hover { transform: scale(1.02); box-shadow: 0 10px 25px rgba(0,0,0,0.3); border-color: rgba(99, 102, 241, 0.3); }
    .modern-select { background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255,255,255,0.1); color: #fff; padding: 0.8rem 1rem; border-radius: 12px; outline: none; }
    
    .edit-online-btn {
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.1);
        color: var(--text-secondary);
        border-radius: 8px;
        padding: 0.4rem 0.6rem;
        cursor: pointer;
        transition: all 0.2s ease;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .edit-online-btn:hover {
        background: rgba(59, 130, 246, 0.15);
        color: #60a5fa;
        border-color: #60a5fa;
    }
</style>

@section Scripts {
    <script>
        async function toggleOnlineStatus(scheduleId, currentIsOnline, currentMeetingLink) {
            const isOnlineStr = prompt("Ця пара онлайн? (Введіть 'так' або 'ні')", currentIsOnline ? "так" : "ні");
            if (isOnlineStr === null) return;
            
            const isOnline = isOnlineStr.trim().toLowerCase() === 'так';
            let meetingLink = currentMeetingLink;
            
            if (isOnline) {
                const link = prompt("Введіть посилання на онлайн зустріч:", currentMeetingLink);
                if (link === null) return;
                meetingLink = link.trim();
            } else {
                meetingLink = null;
            }

            try {
                const response = await fetch(`/Schedule/UpdateOnlineStatus?scheduleId=${scheduleId}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ isOnline: isOnline, meetingLink: meetingLink })
                });

                if (response.ok) {
                    window.location.reload();
                } else {
                    alert('Помилка при оновленні статусу пари.');
                }
            } catch (err) {
                console.error(err);
                alert('Сталася помилка.');
            }
        }
    </script>
}
