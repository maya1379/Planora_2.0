@model IEnumerable<Planora.Services.DTOs.ScheduleEntryDto>
@using Planora.Domain.Enums

@{
    ViewData["Title"] = "Timetable Browser";
    ViewData["Breadcrumb"] = "Schedule / Full Timetable";
}

<div class="glass-card" style="padding: 2rem; margin-bottom: 2rem;">
    <form method="get" asp-action="Index" style="display: flex; gap: 1rem; align-items: flex-end; flex-wrap: wrap;">
        <div style="flex: 1; min-width: 250px;">
            <label style="display: block; margin-bottom: 0.5rem; color: var(--text-secondary); font-size: 0.9rem;">Filter by Group</label>
            <select name="groupId" asp-items="ViewBag.Groups" class="modern-select" style="width: 100%;" onchange="this.form.submit()">
                <option value="">-- All Groups --</option>
            </select>
        </div>
        <div style="flex: 1; min-width: 250px;">
            <label style="display: block; margin-bottom: 0.5rem; color: var(--text-secondary); font-size: 0.9rem;">Filter by Teacher</label>
            <select name="teacherId" asp-items="ViewBag.Teachers" class="modern-select" style="width: 100%;" onchange="this.form.submit()">
                <option value="">-- All Teachers --</option>
            </select>
        </div>
        <a asp-action="Index" class="btn-modern" style="margin: 0; background: rgba(167, 139, 250, 0.1); border: 1px solid rgba(167, 139, 250, 0.2); color: #a78bfa;">Reset</a>
    </form>
</div>

@if (!Model.Any())
{
    <div class="glass-card" style="text-align: center; padding: 5rem;">
        <p style="color: var(--text-secondary); font-size: 1.2rem; margin: 0;">No schedule entries found for current selection.</p>
        <p style="color: rgba(255,255,255,0.3); font-size: 0.9rem; margin-top: 1rem;">Try another filter or generate a new schedule from the Admin panel.</p>
    </div>
}
else
{
    <div style="display: flex; flex-direction: column; gap: 2.5em;">
        @foreach (var day in Enum.GetValues<DayOfWeekEnum>().Where(d => d >= DayOfWeekEnum.Monday && d <= DayOfWeekEnum.Friday))
        {
            var dayEntries = Model.Where(m => m.DayOfWeek == day).OrderBy(m => m.TimeSlotNumber).ToList();
            
            <div class="day-section">
                <h3 style="color: #fff; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 1rem;">
                    <span style="background: linear-gradient(135deg, #6366f1, #a855f7); padding: 0.5rem 1.5rem; border-radius: 12px; font-weight: 700; font-size: 1rem; box-shadow: 0 4px 15px rgba(99, 102, 241, 0.3);">
                        @day.ToString().ToUpper()
                    </span>
                    <span style="height: 1px; flex: 1; background: rgba(255,255,255,0.1);"></span>
                </h3>

                <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.5rem;">
                    @foreach (var slot in dayEntries)
                    {
                        <div class="schedule-card-mini">
                            <div style="display: flex; justify-content: space-between; margin-bottom: 1rem; align-items: flex-start;">
                                <span class="slot-badge">Pair #@slot.TimeSlotNumber</span>
                                <span style="font-size: 0.8rem; color: var(--text-secondary); font-weight: 600;">@slot.StartTime.ToString(@"hh\:mm") - @slot.EndTime.ToString(@"hh\:mm")</span>
                            </div>
                            
                            <h4 style="color: #fff; margin: 0 0 0.5rem 0; font-size: 1rem; line-height: 1.4;">@slot.SubjectName</h4>
                            
                            <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.8rem;">
                                <div style="width: 24px; height: 24px; background: rgba(255,255,255,0.05); border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.4)" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                                </div>
                                <span style="font-size: 0.85rem; color: var(--text-secondary);">@slot.TeacherName</span>
                            </div>

                            <div style="display: flex; justify-content: space-between; border-top: 1px solid rgba(255,255,255,0.05); padding-top: 1rem; margin-top: auto;">
                                <span style="color: #a78bfa; font-size: 0.85rem; font-weight: 600;">@slot.GroupName</span>
                                <span style="color: #34d399; font-size: 0.85rem; font-weight: 600;">Room @slot.ClassroomNumber</span>
                            </div>
                        </div>
                    }
                    
                    @if (!dayEntries.Any())
                    {
                        <div style="grid-column: 1 / -1; padding: 2rem; border: 1px dashed rgba(255,255,255,0.1); border-radius: 12px; text-align: center; color: rgba(255,255,255,0.2);">
                            No lessons scheduled for this day
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}

<style>
    .schedule-card-mini {
        background: rgba(15, 23, 42, 0.4);
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 16px;
        padding: 1.25rem;
        display: flex;
        flex-direction: column;
        transition: all 0.3s ease;
    }
    .schedule-card-mini:hover {
        background: rgba(30, 41, 59, 0.6);
        border-color: rgba(99, 102, 241, 0.4);
        transform: translateY(-4px);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
    }
    .slot-badge {
        font-size: 0.75rem;
        text-transform: uppercase;
        background: rgba(168, 85, 247, 0.1);
        color: #a855f7;
        padding: 0.2rem 0.6rem;
        border-radius: 6px;
        font-weight: 800;
        letter-spacing: 0.05em;
    }
    .modern-select {
        background: rgba(15, 23, 42, 0.6);
        border: 1px solid rgba(255,255,255,0.1);
        color: #fff;
        padding: 0.8rem 1rem;
        border-radius: 12px;
        outline: none;
    }
</style>
