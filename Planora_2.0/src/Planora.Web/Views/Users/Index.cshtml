@model IEnumerable<Planora.Domain.Entities.User>

@{
    ViewData["Title"] = "Users Directory";
    ViewData["Breadcrumb"] = "Admin / Users";
}

<div class="glass-card" style="max-width: 1000px; margin: 0 auto;">
    <div class="glass-card-header" style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid rgba(255, 255, 255, 0.1); padding-bottom: 1rem; margin-bottom: 2rem;">
        <h2 style="font-size: 2rem; color: #fff; margin: 0; font-weight: 700;">Users Directory</h2>
        <a asp-action="Create" class="btn-modern" style="margin: 0 0 0 40ex">+ New User</a>
    </div>

    @if (!Model.Any())
    {
        <div style="text-align: center; padding: 4rem; color: var(--text-secondary); background: rgba(15, 23, 42, 0.4); border-radius: 16px;">
            <p style="font-size: 1.1rem; margin-bottom: 0;">No users found.</p>
        </div>
    }
    else
    {
        <div style="background: rgba(15, 23, 42, 0.4); border-radius: 16px; border: 1px solid rgba(255,255,255,0.05); overflow: hidden;">
            <table style="width: 100%; border-collapse: collapse;">
                <thead>
                    <tr style="background: rgba(255,255,255,0.03); text-align: left; border-bottom: 1px solid rgba(255,255,255,0.05);">
                        <th style="padding: 1rem; color: #fff; font-weight: 600;">Name</th>
                        <th style="padding: 1rem; color: #fff; font-weight: 600;">Email</th>
                        <th style="padding: 1rem; color: #fff; font-weight: 600;">Role</th>
                        <th style="padding: 1rem; color: #fff; font-weight: 600; text-align: right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach(var item in Model)
                    {
                        <tr style="border-bottom: 1px solid rgba(255,255,255,0.03);">
                            <td style="padding: 1rem; color: #60a5fa; font-weight: 600;">@item.FullName</td>
                            <td style="padding: 1rem; color: var(--text-secondary);">@item.Email</td>
                            <td style="padding: 1rem;">
                                @if(item.Role == Planora.Domain.Enums.UserRole.Admin)
                                {
                                    <span style="background: rgba(248, 113, 113, 0.2); color: #f87171; padding: 0.3rem 0.8rem; border-radius: 20px; font-size: 0.8rem; font-weight: 600;">ADMIN</span>
                                }
                                else if(item.Role == Planora.Domain.Enums.UserRole.Teacher)
                                {
                                    <span style="background: rgba(52, 211, 153, 0.2); color: #34d399; padding: 0.3rem 0.8rem; border-radius: 20px; font-size: 0.8rem; font-weight: 600;">TEACHER</span>
                                }
                                else
                                {
                                    <span style="background: rgba(96, 165, 250, 0.2); color: #60a5fa; padding: 0.3rem 0.8rem; border-radius: 20px; font-size: 0.8rem; font-weight: 600;">STUDENT</span>
                                }
                            </td>
                            <td style="padding: 1rem; text-align: right;">
                                <div style="display: flex; gap: 0.5rem; justify-content: flex-end;">
                                    <a asp-action="Edit" asp-route-id="@item.Id" style="padding: 0.4rem 0.8rem; border-radius: 8px; background: rgba(59, 130, 246, 0.1); color: #60a5fa; text-decoration: none; font-size: 0.9rem; transition: background 0.2s;">Edit</a>
                                    
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display: inline;" onsubmit="return confirm('Delete this user?');">
                                        <button type="submit" style="padding: 0.4rem 0.8rem; border-radius: 8px; background: rgba(248, 113, 113, 0.1); color: #f87171; border: none; cursor: pointer; font-size: 0.9rem; transition: background 0.2s;">Delete</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
