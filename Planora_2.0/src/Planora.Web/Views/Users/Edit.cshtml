@model Planora.Web.ViewModels.EditUserViewModel

@{
    ViewData["Title"] = "Редагувати користувача";
    ViewData["Breadcrumb"] = "Адмін / Користувачі / Редагувати";
}

<div class="glass-card" style="max-width: 600px; margin: 0 auto; padding: 2rem;">
    <div style="border-bottom: 1px solid rgba(255, 255, 255, 0.1); padding-bottom: 2rem; margin-bottom: 2rem; text-align: center;">
        <h2 style="font-size: 2rem; color: #fff; margin: 0; font-weight: 700;">Редагувати профіль</h2>
        <p style="color: var(--text-secondary); margin-top: 0.5rem;">Керування профілем @Model.FullName</p>
    </div>

    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="Role" />
        
        <div asp-validation-summary="ModelOnly" style="color: #ef4444; margin-bottom: 1rem; border-radius: 8px; background: rgba(239, 68, 68, 0.1); padding: 1rem;"></div>

        <div style="margin-bottom: 1.5rem;">
            <label asp-for="FullName" style="display: block; margin-bottom: 0.5rem; color: var(--text-secondary); font-weight: 500;">ПІБ</label>
            <input asp-for="FullName" class="modern-input" />
            <span asp-validation-for="FullName" style="color: #ef4444; font-size: 0.85rem;"></span>
        </div>

        <div style="margin-bottom: 1.5rem;">
            <label style="display: block; margin-bottom: 0.5rem; color: var(--text-secondary); font-weight: 500;">Роль</label>
            <div style="padding: 0.8rem 1rem; background: rgba(255,255,255,0.05); border-radius: 12px; color: #fff; font-weight: 600;">
                @Model.Role.ToString().ToUpper()
            </div>
            <p style="font-size: 0.75rem; color: #60a5fa; margin-top: 0.3rem;">* Роль не можна змінити після створення з міркувань безпеки.</p>
        </div>

        @if (Model.Role == Planora.Domain.Enums.UserRole.Student)
        {
            <div style="margin-bottom: 1.5rem;">
                <label asp-for="GroupId" style="display: block; margin-bottom: 0.5rem; color: var(--text-secondary); font-weight: 500;">Призначити до групи</label>
                <select asp-for="GroupId" asp-items="ViewBag.Groups" class="modern-select" style="width: 100%; border: 1px solid rgba(255,255,255,0.1); background: rgba(15, 23, 42, 0.6); padding: 0.8rem 1rem; color: white;">
                    <option value="">-- Без групи --</option>
                </select>
                <span asp-validation-for="GroupId" style="color: #ef4444; font-size: 0.85rem;"></span>
            </div>
        }

        @if (Model.Role == Planora.Domain.Enums.UserRole.Teacher)
        {
            <div style="margin-bottom: 1.5rem;">
                <label asp-for="Faculty" style="display: block; margin-bottom: 0.5rem; color: var(--text-secondary); font-weight: 500;">Факультет / Кафедра</label>
                <input asp-for="Faculty" class="modern-input" />
                <span asp-validation-for="Faculty" style="color: #ef4444; font-size: 0.85rem;"></span>
            </div>
            
            <div style="margin-bottom: 1.5rem;">
                <label asp-for="Position" style="display: block; margin-bottom: 0.5rem; color: var(--text-secondary); font-weight: 500;">Посада</label>
                <input asp-for="Position" class="modern-input" />
                <span asp-validation-for="Position" style="color: #ef4444; font-size: 0.85rem;"></span>
            </div>
        }

        <div style="display: flex; gap: 1rem; justify-content: center; margin-top: 2rem;">
            <button type="submit" class="btn-modern" style="margin: 0; flex: 1;">Зберегти зміни</button>
            <a asp-action="Index" class="btn-modern" style="margin: 0; flex: 1; background: rgba(255,255,255,0.05); text-align: center;">Скасувати</a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
