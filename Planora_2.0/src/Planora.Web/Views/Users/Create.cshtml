@model Planora.Web.ViewModels.CreateUserViewModel

@{
    ViewData["Title"] = "Create User";
    ViewData["Breadcrumb"] = "Admin / Users / Create";
}

<div class="glass-card" style="max-width: 600px; margin: 0 auto; padding: 2rem;">
    <div style="border-bottom: 1px solid rgba(255, 255, 255, 0.1); padding-bottom: 2rem; margin-bottom: 2rem; text-align: center;">
        <h2 style="font-size: 2rem; color: #fff; margin: 0; font-weight: 700;">Add New User</h2>
        <p style="color: var(--text-secondary); margin-top: 0.5rem;">Create a Student, Teacher or Admin.</p>
    </div>

    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" style="color: #ef4444; margin-bottom: 1rem; border-radius: 8px; background: rgba(239, 68, 68, 0.1); padding: 1rem;"></div>

        <div style="margin-bottom: 1.5rem;">
            <label asp-for="FullName" style="display: block; margin-bottom: 0.5rem; color: var(--text-secondary); font-weight: 500;">Full Name</label>
            <input asp-for="FullName" class="modern-input" placeholder="e.g. John Doe" />
            <span asp-validation-for="FullName" style="color: #ef4444; font-size: 0.85rem; display: block; margin-top: 0.5rem;"></span>
        </div>

        <div style="margin-bottom: 1.5rem;">
            <label asp-for="Email" style="display: block; margin-bottom: 0.5rem; color: var(--text-secondary); font-weight: 500;">Email Address</label>
            <input asp-for="Email" class="modern-input" type="email" placeholder="e.g. john@example.com" />
            <span asp-validation-for="Email" style="color: #ef4444; font-size: 0.85rem; display: block; margin-top: 0.5rem;"></span>
        </div>
        
        <div style="margin-bottom: 1.5rem;">
            <label asp-for="Password" style="display: block; margin-bottom: 0.5rem; color: var(--text-secondary); font-weight: 500;">Initial Password</label>
            <input asp-for="Password" class="modern-input" type="password" />
            <span asp-validation-for="Password" style="color: #ef4444; font-size: 0.85rem; display: block; margin-top: 0.5rem;"></span>
        </div>

        <div style="margin-bottom: 1.5rem;">
            <label asp-for="Role" style="display: block; margin-bottom: 0.5rem; color: var(--text-secondary); font-weight: 500;">Role</label>
            <select asp-for="Role" class="modern-select" style="width: 100%; border: 1px solid rgba(255,255,255,0.1); background: rgba(15, 23, 42, 0.6); padding: 0.8rem 1rem; color: white;" onchange="toggleRoleFields(this.value)">
                <option value="Student">Student</option>
                <option value="Teacher">Teacher</option>
                <option value="Admin">Admin</option>
            </select>
            <span asp-validation-for="Role" style="color: #ef4444; font-size: 0.85rem; display: block; margin-top: 0.5rem;"></span>
        </div>

        <div id="studentFields" style="margin-bottom: 1.5rem;">
            <label asp-for="GroupId" style="display: block; margin-bottom: 0.5rem; color: var(--text-secondary); font-weight: 500;">Assign to Group</label>
            <select asp-for="GroupId" asp-items="ViewBag.Groups" class="modern-select" style="width: 100%; border: 1px solid rgba(255,255,255,0.1); background: rgba(15, 23, 42, 0.6); padding: 0.8rem 1rem; color: white;">
                <option value="">-- Select a Group --</option>
            </select>
            <span asp-validation-for="GroupId" style="color: #ef4444; font-size: 0.85rem; display: block; margin-top: 0.5rem;"></span>
        </div>

        <div id="teacherFields" style="margin-bottom: 2rem; display: none;">
            <div style="margin-bottom: 1.5rem;">
                <label asp-for="Faculty" style="display: block; margin-bottom: 0.5rem; color: var(--text-secondary); font-weight: 500;">Faculty / Department</label>
                <input asp-for="Faculty" class="modern-input" placeholder="e.g. Computer Science" />
                <span asp-validation-for="Faculty" style="color: #ef4444; font-size: 0.85rem; display: block; margin-top: 0.5rem;"></span>
            </div>
            
            <div style="margin-bottom: 1.5rem;">
                <label asp-for="Position" style="display: block; margin-bottom: 0.5rem; color: var(--text-secondary); font-weight: 500;">Position</label>
                <input asp-for="Position" class="modern-input" placeholder="e.g. Professor, Assistant" />
                <span asp-validation-for="Position" style="color: #ef4444; font-size: 0.85rem; display: block; margin-top: 0.5rem;"></span>
            </div>
        </div>

        <div style="display: flex; gap: 1rem; justify-content: center; margin-top: 1rem;">
            <button type="submit" class="btn-modern" style="margin: 0; flex: 1;">Create User</button>
            <a asp-action="Index" class="btn-modern" style="margin: 0; flex: 1; background: rgba(255,255,255,0.05); text-align: center;">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        function toggleRoleFields(role) {
            const studentFields = document.getElementById('studentFields');
            const teacherFields = document.getElementById('teacherFields');
            
            if (role === 'Student') {
                studentFields.style.display = 'block';
                teacherFields.style.display = 'none';
            } else if (role === 'Teacher') {
                studentFields.style.display = 'none';
                teacherFields.style.display = 'block';
            } else {
                studentFields.style.display = 'none';
                teacherFields.style.display = 'none';
            }
        }
        
        document.addEventListener('DOMContentLoaded', () => {
            toggleRoleFields(document.getElementById('Role').value);
        });
    </script>
}
