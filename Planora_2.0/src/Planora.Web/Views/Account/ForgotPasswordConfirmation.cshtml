@{
    ViewData["Title"] = "Перевірте пошту";
    ViewData["Breadcrumb"] = "Відновлення паролю";
}

@section Styles {
    <link rel="stylesheet" href="~/css/account.css" asp-append-version="true" />
}

<div class="glass-card" style="max-width: 450px; margin: 5rem auto; text-align: center;">
    <div class="glow-effect glow-top-right"></div>

    <div style="width: 70px; height: 70px; background: rgba(52, 211, 153, 0.1); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem;">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#34d399" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
            <polyline points="22,6 12,13 2,6"></polyline>
        </svg>
    </div>

    <h2 style="font-size: 1.8rem; color: #fff; margin-bottom: 0.75rem; font-weight: 700;">Перевірте пошту</h2>
    <p style="color: var(--text-secondary); font-size: 1.05rem; line-height: 1.6; margin-bottom: 2rem;">
        Якщо такий акаунт існує, ми відправили лист з інструкціями для відновлення паролю на вашу адресу.
    </p>
    
    <a asp-action="Login" class="btn-modern" style="font-size: 1rem; width: 100%; display: block; text-align: center; text-decoration: none;">
        Повернутися до входу
    </a>
</div>
