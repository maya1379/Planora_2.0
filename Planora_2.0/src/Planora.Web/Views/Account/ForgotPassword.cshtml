@model Planora.Web.ViewModels.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Відновлення паролю";
    ViewData["Breadcrumb"] = "Забули пароль";
}

@section Styles {
    <link rel="stylesheet" href="~/css/account.css" asp-append-version="true" />
}

<div class="glass-card" style="max-width: 450px; margin: 5rem auto;">
    <div class="glow-effect glow-top-right"></div>

    <div class="glass-card-header" style="text-align: center; margin-bottom: 2.5rem;">
        <div style="width: 60px; height: 60px; background: rgba(167, 139, 250, 0.1); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem;">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#a78bfa" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
        </div>
        <h2 style="font-size: 1.8rem; color: #fff; margin-bottom: 0.5rem; font-weight: 700;">Забули пароль?</h2>
        <p style="color: var(--text-secondary); font-size: 1rem;">Введіть ваш email і ми надішлемо посилання для відновлення</p>
    </div>

    <form asp-action="ForgotPassword" method="post">
        <div asp-validation-summary="ModelOnly" class="auth-validation-summary"></div>
        
        <div style="margin-bottom: 1.5rem;">
            <label class="auth-label">Ваш Email</label>
            <input asp-for="Email" class="modern-input" placeholder="name@example.com" style="width: 100%; box-sizing: border-box;" />
            <span asp-validation-for="Email" style="color: var(--danger-text); font-size: 0.8rem; display: block; margin-top: 0.4rem;"></span>
        </div>

        <button type="submit" class="btn-modern" style="font-size: 1.1rem; letter-spacing: 0.5px; width: 100%;">
            Надіслати посилання
        </button>
        
        <div class="auth-footer">
            <p style="color: var(--text-secondary);">
                Згадали пароль? 
                <a asp-action="Login">Увійти</a>
            </p>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
