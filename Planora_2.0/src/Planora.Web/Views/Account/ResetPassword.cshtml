@model Planora.Web.ViewModels.ResetPasswordViewModel

@{
    ViewData["Title"] = "Новий пароль";
    ViewData["Breadcrumb"] = "Встановлення нового паролю";
}

@section Styles {
    <link rel="stylesheet" href="~/css/account.css" asp-append-version="true" />
}

<div class="glass-card" style="max-width: 450px; margin: 5rem auto;">
    <div class="glow-effect glow-top-right"></div>

    <div class="glass-card-header" style="text-align: center; margin-bottom: 2.5rem;">
        <div style="width: 60px; height: 60px; background: rgba(167, 139, 250, 0.1); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem;">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#a78bfa" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"></path>
            </svg>
        </div>
        <h2 style="font-size: 1.8rem; color: #fff; margin-bottom: 0.5rem; font-weight: 700;">Новий пароль</h2>
        <p style="color: var(--text-secondary); font-size: 1rem;">Введіть новий пароль для вашого акаунту</p>
    </div>

    <form asp-action="ResetPassword" method="post">
        <div asp-validation-summary="ModelOnly" class="auth-validation-summary"></div>
        
        <input type="hidden" asp-for="Token" />
        <input type="hidden" asp-for="Email" />
        
        <div style="margin-bottom: 1.5rem;">
            <label class="auth-label">Новий пароль</label>
            <input asp-for="Password" class="modern-input" placeholder="••••••••" style="width: 100%; box-sizing: border-box;" />
            <span asp-validation-for="Password" style="color: var(--danger-text); font-size: 0.8rem; display: block; margin-top: 0.4rem;"></span>
        </div>

        <div style="margin-bottom: 2rem;">
            <label class="auth-label">Підтвердження паролю</label>
            <input asp-for="ConfirmPassword" class="modern-input" placeholder="••••••••" style="width: 100%; box-sizing: border-box;" />
            <span asp-validation-for="ConfirmPassword" style="color: var(--danger-text); font-size: 0.8rem; display: block; margin-top: 0.4rem;"></span>
        </div>

        <button type="submit" class="btn-modern" style="font-size: 1.1rem; letter-spacing: 0.5px; width: 100%;">
            Змінити пароль
        </button>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
