@model IEnumerable<Planora.Services.DTOs.BuildingDto>

@{
    ViewData["Title"] = "Buildings Management";
    ViewData["Breadcrumb"] = "Admin / Buildings";
}

<div class="glass-card" style="max-width: 1000px; margin: 0 auto;">
    <div class="glass-card-header" style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid rgba(255, 255, 255, 0.1); padding-bottom: 1rem; margin-bottom: 2rem;">
        <h2 style="font-size: 2rem; color: #fff; margin: 0; font-weight: 700;">Buildings</h2>
        <a asp-action="Create" class="btn-modern" style="margin: 0 0 0 40ex">+ New Building</a>
    </div>

    @if (!Model.Any())
    {
        <div style="text-align: center; padding: 4rem; color: var(--text-secondary); background: rgba(15, 23, 42, 0.4); border-radius: 16px;">
            <p style="font-size: 1.1rem; margin-bottom: 0;">No buildings found in the system.</p>
        </div>
    }
    else
    {
        <div style="background: rgba(15, 23, 42, 0.4); border-radius: 16px; border: 1px solid rgba(255,255,255,0.05); overflow: hidden;">
            <table style="width: 100%; border-collapse: collapse;">
                <thead>
                    <tr style="background: rgba(255,255,255,0.03); text-align: left; border-bottom: 1px solid rgba(255,255,255,0.05);">
                        <th style="padding: 1rem; color: #fff; font-weight: 600;">Building Name</th>
                        <th style="padding: 1rem; color: #fff; font-weight: 600;">Address</th>
                        <th style="padding: 1rem; color: #fff; font-weight: 600; text-align: right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach(var item in Model)
                    {
                        <tr style="border-bottom: 1px solid rgba(255,255,255,0.03);">
                            <td style="padding: 1rem; color: #60a5fa; font-weight: 600;">@item.Name</td>
                            <td style="padding: 1rem; color: var(--text-secondary);">@item.Address</td>
                            <td style="padding: 1rem; text-align: right;">
                                <div style="display: flex; gap: 0.5rem; justify-content: flex-end;">
                                    <a asp-controller="Classrooms" asp-action="AdminIndex" asp-route-buildingId="@item.Id" style="padding: 0.4rem 0.8rem; border-radius: 8px; background: rgba(15, 23, 42, 0.6); color: #fff; text-decoration: none; font-size: 0.8rem; border: 1px solid rgba(255,255,255,0.1);">Rooms</a>
                                    
                                    <a asp-action="Edit" asp-route-id="@item.Id" style="padding: 0.4rem 0.8rem; border-radius: 8px; background: rgba(59, 130, 246, 0.1); color: #60a5fa; text-decoration: none; font-size: 0.8rem;">Edit</a>
                                    
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display: inline;" onsubmit="return confirm('Delete this building? All rooms inside will be affected.');">
                                        <button type="submit" style="padding: 0.4rem 0.8rem; border-radius: 8px; background: rgba(248, 113, 113, 0.1); color: #f87171; border: none; cursor: pointer; font-size: 0.8rem;">Delete</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
