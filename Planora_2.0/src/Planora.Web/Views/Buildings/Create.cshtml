@model Planora.Services.DTOs.CreateBuildingDto

@{
    ViewData["Title"] = "Create Building";
    ViewData["Breadcrumb"] = "Admin / Buildings / Create";
}

<div class="glass-card" style="max-width: 600px; margin: 0 auto; padding: 2.5rem;">
    <div style="border-bottom: 1px solid rgba(255, 255, 255, 0.1); padding-bottom: 2rem; margin-bottom: 2rem; text-align: center;">
        <h2 style="font-size: 2rem; color: #fff; margin: 0; font-weight: 700;">Add New Building</h2>
        <p style="color: var(--text-secondary); margin-top: 0.5rem;">Buildings contain multiple classrooms and labs.</p>
    </div>

    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" style="color: #ef4444; margin-bottom: 1rem;"></div>

        <div style="margin-bottom: 1.5rem;">
            <label asp-for="Name" style="display: block; margin-bottom: 0.5rem; color: var(--text-secondary); font-weight: 500;">Building Name (e.g. Main Building)</label>
            <input asp-for="Name" class="modern-input" placeholder="Enter name..." />
            <span asp-validation-for="Name" style="color: #ef4444; font-size: 0.85rem;"></span>
        </div>

        <div style="margin-bottom: 2rem;">
            <label asp-for="Address" style="display: block; margin-bottom: 0.5rem; color: var(--text-secondary); font-weight: 500;">Physical Address</label>
            <input asp-for="Address" class="modern-input" placeholder="e.g. University Str, 15" />
            <span asp-validation-for="Address" style="color: #ef4444; font-size: 0.85rem;"></span>
        </div>

        <div style="display: flex; gap: 1rem;">
            <button type="submit" class="btn-modern" style="margin: 0; flex: 1;">Create Building</button>
            <a asp-action="Index" class="btn-modern" style="margin: 0; flex: 1; background: rgba(255,255,255,0.05); text-align: center;">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
